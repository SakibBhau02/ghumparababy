# Copy to .env and fill in (never commit .env)
# Postgres (Neon recommended for Vercel):
# - DATABASE_URL = pooled connection string + &pgbouncer=true&connection_limit=1
# - DIRECT_URL   = direct connection string (for prisma migrate/db push)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET=generate-a-long-random-string

# Optional: Meta Pixel (can also be set from Admin → Pixel সেটআপ)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

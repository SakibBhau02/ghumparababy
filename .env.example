# Copy to .env and fill in (never commit .env)
# Postgres (Neon recommended for Vercel):
# - DATABASE_URL = pooled connection string + &pgbouncer=true&connection_limit=1
# - DIRECT_URL   = direct connection string (for prisma migrate/db push)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Local dev via Docker (docker compose up -d) — uncomment to use local DB:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5436/ghumparababy?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5436/ghumparababy?schema=public

# Admin panel login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SECRET=generate-a-long-random-string

# Optional: Meta Pixel (can also be set from Admin → Pixel সেটআপ)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# R2 bucket uploads (one-time `npm run upload:r2`; never commit real keys)
# Cloudflare dashboard → R2 → API Tokens (Object Read & Write on the bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ghumpara

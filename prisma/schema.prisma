// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Order {
  id            String   @id @default(cuid())
  orderCode     String   @unique
  name          String
  phone         String
  address       String
  division      String   @default("")
  district      String   @default("")
  upazila       String   @default("")
  color         String
  colors        String   @default("[]")
  packageName   String
  quantity      Int
  unitPrice     Int
  deliveryZone  String   @default("")
  deliveryCharge Int     @default(0)
  totalPrice    Int
  status        String   @default("pending")
  pinned        Boolean  @default(false)
  waSent        Boolean  @default(false)
  consignmentId String   @default("")
  trackingCode  String   @default("")
  shopbaseOrderId String @default("")
  adminNote     String   @default("")
  /**
   * Mixed-cart line items (JSON array of OrderLineItem).
   * "[]" = legacy single-product order (old columns are the truth).
   * New orders always store full lines here; legacy columns stay filled
   * as a summary so every old consumer keeps working.
   */
  items         String   @default("[]")
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Customer {
  phone        String   @id
  name         String   @default("")
  address      String   @default("")
  division     String   @default("")
  district     String   @default("")
  upazila      String   @default("")
  email        String   @default("")
  tags         String   @default("[]")
  note         String   @default("")
  blacklisted  Boolean  @default(false)
  orderCount   Int      @default(0)
  totalSpent   Int      @default(0)
  firstOrderAt DateTime @default(now())
  lastOrderAt  DateTime @default(now())
}

model Product {
  id              String           @id @default(cuid())
  name            String
  tagline         String           @default("")
  description     String           @default("")
  imageUrl        String           @default("")
  price           Int              @default(0)
  oldPrice        Int              @default(0)
  sku             String           @default("")
  shopbaseSku     String           @default("")
  size            String           @default("")
  maxQty          Int              @default(5)
  stock           Int              @default(0)
  featured      Boolean          @default(false)
  featuredOrder Int              @default(0)
  active          Boolean          @default(true)
  sortOrder       Int              @default(0)
  variants        ProductVariant[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProductVariant {
  id          String  @id @default(cuid())
  productId   String
  name        String
  label       String  @default("")
  colorHex    String  @default("")
  imageUrl    String  @default("")
  sku         String  @default("")
  shopbaseSku String  @default("")
  price       Int?
  oldPrice    Int?
  stock       Int     @default(0)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
